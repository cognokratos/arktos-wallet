DATABASE_PATH=data/arktos.db
ADMIN_API_KEY=
# Generate each with `make secret` (32 random bytes, base64). Use independent values.
DATABASE_KEY=
MASTER_KEY=
RUST_LOG=info
# Comma-separated Host values accepted on /mcp (default: localhost,127.0.0.1,::1)
MCP_ALLOWED_HOSTS=
# Bitcoin network for address encoding: mainnet (default), testnet, signet, regtest
BITCOIN_NETWORK=
# EIP-155 chain ID reported with Ethereum addresses (default 1 = Ethereum mainnet)
ETHEREUM_CHAIN_ID=
